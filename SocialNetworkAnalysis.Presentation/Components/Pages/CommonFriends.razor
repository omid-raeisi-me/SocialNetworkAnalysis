@page "/CommonFriends"

<div class="algorithm-panel collapsed">

	<div class="algorithm-header">

		<div class="algorithm-info">

			<div class="algorithm-icon">
				<i class="bi bi-people"></i>
			</div>

			<div>

				<div class="algorithm-name">
					Common Friends
				</div>

			</div>

		</div>

		<div class="algorithm-actions">

			<button class="panel-btn collapse-btn">

				<i class="bi bi-chevron-up"></i>

			</button>

		</div>

	</div>

	<div class="algorithm-body">

		<div class="algorithm-content">

			<div class="panel-section">

				<input class="form-control"
				placeholder="Node1 Id"
				@bind="_node1Id" />

			</div>

			<div class="panel-section">

				<input class="form-control"
				placeholder="Node2 Id"
				@bind="_node2Id" />

			</div>

			<div class="friends-section">
				<div class="friends-list">
					<div class="info-row">
						<span>Common Friends :</span>
					</div>
					@if (_commonFriends?.Any() == true)
					{

						@foreach (var item in _commonFriends)
						{
							<div class="friend-item">

								<span>
									@($"{item.Id}. {item.Name}")
								</span>

							</div>
						}
					}
					else if(_haveCommonFriends == 0)
					{
						<span>Don't have any friends</span>
					}


				</div>
			</div>

		</div>

		<div class="algorithm-footer">

			<button class="btn btn-primary w-100" @onclick="Run">

				<i class="bi bi-play-fill"></i>

				Run

			</button>

		</div>

	</div>

</div>

<script src="/assets/js/pages.js"></script>
