@page "/EdgeAction"

<div class="algorithm-panel collapsed" style="max-height:285px">

	<div class="algorithm-header">

		<div class="algorithm-info">

			<div class="algorithm-icon">
				<i class="bi bi-diagram-3-fill"></i>
			</div>

			<div>

				<div class="algorithm-name">
					Edge Action
				</div>

			</div>

		</div>

		<div class="algorithm-actions">

			<button class="panel-btn collapse-btn">

				<i class="bi bi-chevron-up"></i>

			</button>

		</div>

	</div>

	<div class="algorithm-body">

		<div class="algorithm-content">

			<div class="panel-section">

				<input class="form-control"
					   placeholder="From Id"
					   @bind="_fromId" />

			</div>

			<div class="panel-section">

				<input class="form-control"
					   placeholder="To Id"
					   @bind="_toId" />

			</div>

		</div>

		<div class="algorithm-footer">

			<div class="row">
				<div class="col-6">
					<button class="btn btn-success w-100" @onclick="Add">

						<i class="bi bi-share"></i>

						Add

					</button>
				</div>

				<div class="col-6">
					<button class="btn btn-danger w-100" @onclick="Remove">

						<i class="bi bi-trash"></i>

						Remove

					</button>
				</div>
			</div>

		</div>

	</div>

</div>

<script src="/assets/js/pages.js"></script>