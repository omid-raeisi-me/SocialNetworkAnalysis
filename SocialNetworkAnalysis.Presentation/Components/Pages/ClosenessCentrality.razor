@page "/ClosenessCentrality"

<div class="algorithm-panel collapsed">

	<div class="algorithm-header">

		<div class="algorithm-info">

			<div class="algorithm-icon">
				<i class="bi bi-bullseye"></i>
			</div>

			<div>

				<div class="algorithm-name">
					Closeness Centrality
				</div>

			</div>

		</div>

		<div class="algorithm-actions">

			<button class="panel-btn collapse-btn">

				<i class="bi bi-chevron-up"></i>

			</button>

		</div>

	</div>

	<div class="algorithm-body">

		<div class="algorithm-content">

			<div class="info-row">
				<span>Max Score :</span>
				<span>@_closenessCentralityDto.MaxScore</span>
			</div>

			@if (_closenessCentralityDto.CentralityNodes?.Any() == true)
			{
				<div class="friends-section">
					<div class="friends-list">
						<div class="info-row">
							<span>Centrality :</span>
						</div>
						@foreach (var item in _closenessCentralityDto.CentralityNodes)
						{
							<div class="friend-item">

								<span>
									@($"{item.Id}. {item.Name}")
								</span>

							</div>
						}
					</div>

				</div>
			}

			@if (_closenessCentralityDto.ClosenessScores?.Any() == true)
			{
				<div class="friends-section">
					<div class="friends-list">
						<div class="info-row">
							<span>Closeness Scores :</span>
						</div>
						@foreach (var item in _closenessCentralityDto.ClosenessScores)
						{
							<div class="friend-item">

								<span>
									@($"{item.Key.Id}. {item.Key.Name} : {item.Value}")
								</span>

							</div>
						}
					</div>

				</div>
			}

		</div>

	</div>

</div>

<script src="/assets/js/pages.js"></script>