@page "/BetweennessCentrality"

<div class="algorithm-panel collapsed">

	<div class="algorithm-header">

		<div class="algorithm-info">

			<div class="algorithm-icon">
				<i class="bi bi-node-plus"></i>
			</div>

			<div>

				<div class="algorithm-name">
					Betweenness Centrality
				</div>

			</div>

		</div>

		<div class="algorithm-actions">

			<button class="panel-btn collapse-btn">

				<i class="bi bi-chevron-up"></i>

			</button>

		</div>

	</div>

	<div class="algorithm-body">

		<div class="algorithm-content">

			<div class="info-row">
				<span>Max Score :</span>
				<span>@_betweennessCentralityDto.MaxScore</span>
			</div>

			@if (_betweennessCentralityDto.MostInfluentialNodes?.Any() == true)
			{
				<div class="friends-section">
					<div class="friends-list">
						<div class="info-row">
							<span>Most Influential :</span>
						</div>
						@foreach (var item in _betweennessCentralityDto.MostInfluentialNodes)
						{
							<div class="friend-item">

								<span>
									@($"{item.Id}. {item.Name}")
								</span>

							</div>
						}
					</div>

				</div>
			}

			@if (_betweennessCentralityDto.CentralityScores?.Any() == true)
			{
				<div class="friends-section">
					<div class="friends-list">
						<div class="info-row">
							<span>Centrality Scores :</span>
						</div>
						@foreach (var item in _betweennessCentralityDto.CentralityScores)
						{
							<div class="friend-item">

								<span>
									@($"{item.Key.Id}. {item.Key.Name} : {item.Value}")
								</span>

							</div>
						}
					</div>

				</div>
			}

		</div>

	</div>

</div>

<script src="/assets/js/pages.js"></script>