@inherits LayoutComponentBase

<div class="admin-shell">

	<Sidebar />

	<div class="admin-main">

		<main class="dashboard-content">
			<div class="graph-page">

				<div class="graph-card">

					<div class="graph-toolbar">

						<div class="toolbar-left">

							<a class="btn btn-primary btn-sm" href="/InsertNode">
								<i class="bi bi-plus-lg"></i>
								Node
							</a>

							<button class="btn btn-outline-primary btn-sm">
								<i class="bi bi-share"></i>
								Edge
							</button>

							<button class="btn btn-outline-primary btn-sm" @onclick="Save">
								<i class="bi bi-save"></i>
								Save
							</button>

							<div class="toolbar-divider"></div>

							<button class="btn btn-light btn-sm">
								<i class="bi bi-bounding-box"></i>
							</button>

						</div>

						<div class="toolbar-right">

							<div class="node-search">
								<div class="search-input-wrapper">
									<i class="bi bi-search search-icon"></i>
									<input type="text" class="search-input" placeholder="Search nodes..." value="@_searchQuery" @oninput="OnSearchInput" autocomplete="off" />
									@if (!string.IsNullOrWhiteSpace(_searchQuery))
									{
										<button class="search-clear" @onclick="ClearSearch"> <i class="bi bi-x"></i> </button>
									}
								</div>
								@if (_showSearchResults)
								{
									<div class="search-results">
										@if (_searchResults.Count == 0)
										{
											<div class="search-no-results"> <i class="bi bi-search"></i> <span>No users found</span> </div>
										}
										else
										{
											@foreach (var result in _searchResults)
											{
												<button class="search-result" @onclick="() => SelectSearchResult(result.Id)">
													<div class="search-result-icon">
														<i class="bi bi-person"></i>
													</div>
													<div class="search-result-info">
														<span class="search-result-name"> @result.Name </span>
														<span class="search-result-id"> ID: @result.Id </span>
													</div>
												</button>
											}
										}
									</div>
								}
							</div>

						</div>

					</div>

					<div id="cy"></div>

					@if (_selectedNode is not null)
					{
						<div class="node-panel"
							 style="left:@($"{_panelX}px"); top:@($"{_panelY}px");">

							<div class="node-panel-header">

								<span>@_selectedNode.Name</span>

								<button class="close-btn"
										@onclick="ClosePanel">
									×
								</button>

							</div>

							<div class="node-panel-body">

								<div class="info-row">
									<span>Id</span>
									<span>@_selectedNode.Id</span>
								</div>

								<div class="info-row">
									<span>Name</span>
									<span>@_selectedNode.Name</span>
								</div>

								<div class="info-row">
									<span>Degree</span>
									<span>@_selectedNode.Degree</span>
								</div>

								@if (_selectedNode.Friends?.Any() == true)
								{
									<div class="friends-section">
										<div class="friends-list">
											<div class="info-row">
												<span>Friends :</span>
											</div>
											@foreach (var friend in _selectedNode.Friends)
											{
												<div class="friend-item">

													<span>
														@($"{friend.Id}. {friend.Name}")
													</span>

												</div>
											}

										</div>

									</div>
								}

							</div>

						</div>
					}


					@if (_showNodeMenu)
					{
						<div class="context-menu"
							 style="left:@($"{_menuX}px"); top:@($"{_menuY}px");">

							<div class="panel-header" style="margin :  0px !important;">

								<div class="panel-title">

									<span>Actions</span>

								</div>

								<button class="close-btn" @onclick="ClosePanel" style="width:10px!important;">
									<i class="bi bi-x"></i>
								</button>

							</div>

							<div style="padding: 10px;">
								<a class="btn btn-warning" style="width:100%; margin-bottom:10px;" href="/UpdateNode/@_selectedNodeId">
									<i class="bi bi-pencil-square"></i>
									Update
								</a>

								<a class="btn btn-danger" style="width:100%;" @onclick="DeleteUser">
									<i class="bi bi-trash"></i>
									Delete
								</a>

								<a class="btn btn-info" style="width:100%;" href="/DistancesFromAll/@_selectedNodeId">
									<i class="bi bi-trash"></i>
									Distance
								</a>
							</div>

						</div>
					}

					@Body

					<div class="graph-status">

						<span>Nodes : 0</span>

						<span>Edges : 0</span>

					</div>

				</div>

			</div>
		</main>
	</div>
</div>